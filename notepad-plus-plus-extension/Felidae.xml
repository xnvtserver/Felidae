<NotepadPlus>
    <UserLang name="Felidae" ext="fx" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="no" allowFoldOfComments="no" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00 01 02# 03</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1"></Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1">=&gt; := == != &lt;= &gt;= &lt; &gt; + - * / , | ? .</Keywords>
            <Keywords name="Operators2"></Keywords>
            <Keywords name="Folders in code1, open">{</Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close">}</Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in comment, open"></Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close"></Keywords>
            <Keywords name="Keywords1">extend where if else return lambda then import</Keywords>
            <Keywords name="Keywords2">nil true false</Keywords>
            <Keywords name="Keywords3">any array bool boolean decimal double float int number string</Keywords>
            <Keywords name="Keywords4">array comparison console csv db exception fact fact_analysis file flibrary fn group gtk http json list logic math ml package pair plot prelude probability process qt set smoke str system thread wordnet</Keywords>
            <Keywords name="Keywords5">count average sort search contains lower upper length throw type instanceof</Keywords>
            <Keywords name="Keywords6"></Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
            <Keywords name="Delimiters">00"01\02"03 04 05 06 07 08</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" styleID="11" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="COMMENT" styleID="1" fgColor="608060" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
            <WordsStyle name="COMMENT LINE" styleID="2" fgColor="608060" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" nesting="0" />
            <WordsStyle name="NUMBER" styleID="4" fgColor="A05A2C" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD1" styleID="5" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD2" styleID="6" fgColor="B00040" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD3" styleID="7" fgColor="007070" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD4" styleID="8" fgColor="8000C0" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD5" styleID="9" fgColor="267F99" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD6" styleID="10" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD7" styleID="16" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="KEYWORD8" styleID="17" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="OPERATOR" styleID="3" fgColor="404040" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" styleID="12" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN CODE2" styleID="13" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="FOLDER IN COMMENT" styleID="14" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="DELIMINER1" styleID="18" fgColor="AA5500" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="DELIMINER2" styleID="19" fgColor="AA5500" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
            <WordsStyle name="DELIMINER3" styleID="20" fgColor="AA5500" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
