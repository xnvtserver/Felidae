# Felidae source files.

# GitHub Linguist must recognize Felidae upstream before GitHub can provide

# native Felidae language statistics and syntax highlighting.

*.fx linguist-language=Felidae
*.fx linguist-detectable=true

# Generated build outputs should not count toward repository language statistics.

build/** linguist-generated=true
build-clang/** linguist-generated=true

# Generated and packaged VS Code extension artifacts.

vs-code-extension/out/** linguist-generated=true
vs-code-extension/*.vsix linguist-generated=true

# Generated Felidae example data.

examples/data/converted_*.fx linguist-generated=true

# Third-party dependencies should not count as project-authored source code.

third_party/** linguist-vendored=true
vs-code-extension/node_modules/** linguist-vendored=true

#configs
*.fx linguist-detectable=true
*.fx linguist-documentation=false
*.fx linguist-generated=false
*.fx linguist-vendored=false
*.fx text eol=lf
datasets/**/*.jsonl text eol=lf
models/*.model binary

examples/data/converted_*.fx linguist-detectable=false

# Compiled binaries and packaged archives.

*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.vsix binary
*.zip binary
