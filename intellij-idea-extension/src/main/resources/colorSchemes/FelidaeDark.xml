<scheme name="Felidae Dark" version="142" parent_scheme="Darcula">
    <!--
      Bundled editor colour scheme for Felidae, targeting the FELIDAE_* keys
      declared in local.felidae.intellij.highlighting.FelidaeTextAttributes
      (the same keys the Felidae page under Settings | Editor | Color Scheme
      exposes for manual tweaking). Palette matches the VS Code extension's
      "Felidae Dark" theme so both IDEs render .fx files the same way.

      Inherits from Darcula so every non-Felidae language keeps sensible
      colours; only the Felidae-specific keys are overridden here.
    -->
    <colors>
        <option name="CARET_ROW_COLOR" value="12201d"/>
        <option name="SELECTION_BACKGROUND" value="1d3531"/>
    </colors>
    <attributes>
        <option name="FELIDAE_COMMENT">
            <value>
                <option name="FOREGROUND" value="5c7a75"/>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <option name="FELIDAE_STRING">
            <value>
                <option name="FOREGROUND" value="9ede8a"/>
            </value>
        </option>
        <option name="FELIDAE_NUMBER">
            <value>
                <option name="FOREGROUND" value="f7a93f"/>
            </value>
        </option>
        <option name="FELIDAE_KEYWORD">
