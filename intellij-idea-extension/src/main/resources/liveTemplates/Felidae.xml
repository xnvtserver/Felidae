<templateSet group="Felidae">
    <template name="main" value="main(arguments: system.stdin) =&gt;&#10;    status := system.print(value: &quot;Felidae system running!&quot;)&#10;    return (&#10;        status: status&#10;    )" description="Create a direct-execution entry point" toReformat="false" toShortenFQNames="false">
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="fact" value="$PREDICATE$($NAME$: $VALUE$)" description="Create a Felidae fact" toReformat="false" toShortenFQNames="false">
        <variable name="PREDICATE" expression="" defaultValue="&quot;Predicate&quot;" alwaysStopAt="true"/>
        <variable name="NAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="method" value="$NAME$($INPUT$: $TYPE$) =&gt;&#10;    $ITEM$ := $INPUT$&#10;    where $ITEM$.$FIELD$ &gt;= $THRESHOLD$&#10;    return (&#10;        $RESULTNAME$: $ITEM$.$RESULTFIELD$&#10;    )" description="Create a method-style typed rule" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;isAdult&quot;" alwaysStopAt="true"/>
        <variable name="INPUT" expression="" defaultValue="&quot;input&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Person&quot;" alwaysStopAt="true"/>
        <variable name="ITEM" expression="" defaultValue="&quot;p&quot;" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="&quot;age&quot;" alwaysStopAt="true"/>
        <variable name="THRESHOLD" expression="" defaultValue="&quot;18&quot;" alwaysStopAt="true"/>
        <variable name="RESULTNAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="RESULTFIELD" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="fallback" value="$NAME$($INPUT$: $TYPE$) =&gt;&#10;    $ITEM$ := $INPUT$&#10;    $ITEM$.$FIELD$ == &quot;$MATCHVALUE$&quot;&#10;    return (&#10;        $RESULTNAME$: $ITEM$.$RESULTFIELD$,&#10;        $STATUSNAME$: &quot;$STATUSVALUE$&quot;&#10;    )&#10;else&#10;    return (&#10;        $RESULTNAME$: $ITEM$.$RESULTFIELD$,&#10;        $STATUSNAME$: &quot;$DEFAULTVALUE$&quot;&#10;    )" description="Create an ordered fallback method-style rule" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;RoleAccess&quot;" alwaysStopAt="true"/>
        <variable name="INPUT" expression="" defaultValue="&quot;input&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Employee&quot;" alwaysStopAt="true"/>
        <variable name="ITEM" expression="" defaultValue="&quot;e&quot;" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="&quot;role&quot;" alwaysStopAt="true"/>
        <variable name="MATCHVALUE" expression="" defaultValue="&quot;Engineer&quot;" alwaysStopAt="true"/>
        <variable name="RESULTNAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="RESULTFIELD" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="STATUSNAME" expression="" defaultValue="&quot;status&quot;" alwaysStopAt="true"/>
        <variable name="STATUSVALUE" expression="" defaultValue="&quot;engineering&quot;" alwaysStopAt="true"/>
        <variable name="DEFAULTVALUE" expression="" defaultValue="&quot;default&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="lambda" value="lambda($TYPE$, $ITEM$ =&gt; $ITEM$.$FIELD$ &gt;= $VALUE$)" description="Create a lambda filter or map expression" toReformat="false" toShortenFQNames="false">
        <variable name="TYPE" expression="" defaultValue="&quot;Person&quot;" alwaysStopAt="true"/>
        <variable name="ITEM" expression="" defaultValue="&quot;p&quot;" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="&quot;age&quot;" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="&quot;18&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="throw" value="throw(msg: &quot;$REASON$&quot;)&#10;error_reason == &quot;$REASON$&quot;" description="Signal and check a Felidae exception reason" toReformat="false" toShortenFQNames="false">
        <variable name="REASON" expression="" defaultValue="&quot;DivisionByZero&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="factall" value="$ROWS$ := Fact.all(type: &quot;$TYPENAME$&quot;)" description="Read every currently loaded fact of a type from the in-memory fact store" toReformat="false" toShortenFQNames="false">
        <variable name="ROWS" expression="" defaultValue="&quot;rows&quot;" alwaysStopAt="true"/>
        <variable name="TYPENAME" expression="" defaultValue="&quot;TypeName&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="factfind" value="$ROWS$ := Fact.find(type: &quot;$TYPENAME$&quot;, field: &quot;$FIELD$&quot;, equals: $VALUE$)" description="Read facts of a type whose field equals a value from the in-memory fact store" toReformat="false" toShortenFQNames="false">
        <variable name="ROWS" expression="" defaultValue="&quot;rows&quot;" alwaysStopAt="true"/>
        <variable name="TYPENAME" expression="" defaultValue="&quot;TypeName&quot;" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="&quot;field&quot;" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="probfn" value="$RESULT$ := probability.$FN$(data: $VALUES$)" description="Call a native Felidae probability/statistics function" toReformat="false" toShortenFQNames="false">
        <variable name="RESULT" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="FN" expression="" defaultValue="&quot;mean&quot;" alwaysStopAt="true"/>
        <variable name="VALUES" expression="" defaultValue="&quot;values&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>
</templateSet>
