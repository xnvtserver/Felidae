<idea-plugin>
    <id>local.felidae.intellij</id>
    <name>Felidae</name>

    <vendor email="felidae@example.com" url="https://github.com/xnvtserver/Felidae">
        Felidae Project
    </vendor>

    <description>
        <![CDATA[
        Felidae language support for .fx files, backed by Celidae diagnostics,
        runtime checks, run actions, and data graph inspection.
        ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Felidae"
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeFileType"
                fieldName="INSTANCE"
                extensions="fx"/>

        <lang.syntaxHighlighterFactory
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeSyntaxHighlighterFactory"/>

        <externalAnnotator
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeExternalAnnotator"/>

        <toolWindow
                id="Felidae"
                anchor="bottom"
                icon="/icons/felidaeToolWindow.svg"
                factoryClass="local.felidae.intellij.ui.FelidaeToolWindowFactory"/>

        <configurationType
                implementation="local.felidae.intellij.run.FelidaeConfigurationType"/>

        <lang.commenter
                language="Felidae"
                implementationClass="local.felidae.intellij.editor.FelidaeCommenter"/>
        <lang.braceMatcher
                language="Felidae"
                implementationClass="local.felidae.intellij.editor.FelidaeBraceMatcher"/>

        <lang.foldingBuilder
                language="Felidae"
                implementationClass="local.felidae.intellij.editor.FelidaeFoldingBuilder"/>

        <lang.psiStructureViewFactory
                language="Felidae"
                implementationClass="local.felidae.intellij.editor.FelidaeStructureViewFactory"/>

        <lang.quoteHandler
                fileType="Felidae"
                implementationClass="local.felidae.intellij.editor.FelidaeQuoteHandler"/>
        <colorSettingsPage
                implementation="local.felidae.intellij.highlighting.FelidaeColorSettingsPage"/>

        <bundledColorScheme path="/colorSchemes/FelidaeDark"/>

        <defaultLiveTemplates file="/liveTemplates/Felidae.xml"/>

        <lang.documentationProvider
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeDocumentationProvider"/>

        <completion.contributor
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeCompletionContributor"/>

        <gotoDeclarationHandler
                implementation="local.felidae.intellij.FelidaeGotoDeclarationHandler"/>

        <codeInsight.parameterInfo
                language="Felidae"
                implementationClass="local.felidae.intellij.FelidaeParameterInfoHandler"/>

        <editorFactoryListener
                implementation="local.felidae.intellij.editor.FelidaeRunGutterManager"/>

        <projectConfigurable
                id="local.felidae.intellij.settings.FelidaeConfigurable"
                instance="local.felidae.intellij.settings.FelidaeConfigurable"
                displayName="Felidae"/>
    </extensions>

    <actions>
        <action
                id="Felidae.CheckFile"
                class="local.felidae.intellij.actions.FelidaeCheckAction"
                text="Check Felidae File"
                description="Check the current Felidae file using Celidae"
                icon="/icons/felidaeCheck.svg">

            <add-to-group
                    group-id="ToolsMenu"
                    anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt F9"/>
        </action>

        <action
                id="Felidae.RunFile"
                class="local.felidae.intellij.actions.FelidaeRunAction"
                text="Run Felidae File"
                description="Run the current Felidae file using the interpreter"
                icon="/icons/felidaeRun.svg">

            <add-to-group
                    group-id="RunMenu"
                    anchor="last"/>
            <add-to-group
                    group-id="ProjectViewPopupMenu"
                    anchor="last"/>

            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt F10"/>
        </action>

        <action
                id="Felidae.RunQuery"
                class="local.felidae.intellij.actions.FelidaeRunQueryAction"
                text="Run Felidae Query..."
                description="Prompt for a Felidae query and run it against the current file"
                icon="/icons/felidaeRun.svg">

            <add-to-group
                    group-id="RunMenu"
                    anchor="last"/>
            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt F12"/>
        </action>

        <action
                id="Felidae.VisualizeFile"
                class="local.felidae.intellij.actions.FelidaeVisualizeAction"
                text="Visualize Felidae Data Graph"
                description="Inspect the current Felidae file using Celidae visual analytics"
                icon="/icons/felidaeAction.svg">

            <add-to-group
                    group-id="ToolsMenu"
                    anchor="last"/>
            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt F11"/>
        </action>

        <action
                id="Felidae.FormatFile"
                class="local.felidae.intellij.actions.FelidaeFormatAction"
                text="Format Felidae File"
                description="Reformat the current Felidae file's indentation, blank lines, and trailing whitespace"
                icon="AllIcons.Actions.ReformatCode">

            <add-to-group
                    group-id="ToolsMenu"
                    anchor="last"/>
            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl alt F8"/>
        </action>
    </actions>
</idea-plugin>

