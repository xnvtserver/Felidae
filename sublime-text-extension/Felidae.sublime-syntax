%YAML 1.2
---
# Sublime Text syntax definition for Felidae (.fx). See
# https://www.sublimetext.com/docs/syntax.html
name: Felidae
file_extensions:
  - fx
scope: source.felidae

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: keywords
    - include: declarations
    - include: bindings
    - include: library-calls
    - include: data-types
    - include: operators
    - include: structures

  comments:
    - match: '#'
      scope: punctuation.definition.comment.felidae
      push:
        - meta_scope: comment.line.number-sign.felidae
        - match: $
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.felidae
      push:
        - meta_scope: string.quoted.double.felidae
        - match: '\\.'
          scope: constant.character.escape.felidae
        - match: '"'
          scope: punctuation.definition.string.end.felidae
          pop: true

  numbers:
    - match: '(?<![A-Za-z0-9_])-?\d+(\.\d+)?\b'
      scope: constant.numeric.felidae

  keywords:
    - match: '\b(extend|where|if|else|return|lambda|then)\b'
      scope: keyword.control.felidae
    - match: '\bimport\b'
      scope: keyword.control.import.felidae
    - match: '\b(nil|true|false)\b'
      scope: constant.language.felidae

  declarations:
    # `Name(...)` or `Name(...) =>` at the start of a line - a method/fact
    # declaration head.
    - match: '^\s*([A-Za-z_][A-Za-z0-9_:.]*)(?=\s*\()'
      scope: entity.name.function.felidae
    - match: '\bextend\b\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: entity.other.inherited-class.felidae

  bindings:
    # `name := ...`
    - match: '\b([A-Za-z_][A-Za-z0-9_]*)\b(?=\s*:=)'
      scope: variable.other.felidae

  library-calls:
    - match: '\b(array|comparison|console|csv|db|exception|fact|fact_analysis|file|flibrary|fn|group|gtk|http|json|list|logic|math|ml|package|pair|plot|prelude|probability|process|qt|set|smoke|str|system|thread|wordnet)\b(?=\s*[:.])'
      scope: support.class.felidae
    - match: '(?<=[:.])\s*[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: support.function.felidae

  data-types:
    - match: '(?<=:)\s*\b(any|array|bool|boolean|decimal|double|float|int|number|string)\b'
      scope: storage.type.felidae
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: storage.type.felidae

  operators:
    - match: '=>|:=|==|!=|<=|>='
      scope: keyword.operator.felidae
    - match: '[+\-*/]'
      scope: keyword.operator.arithmetic.felidae
    - match: '\|'
      scope: keyword.operator.logical.felidae
    - match: ','
      scope: punctuation.separator.felidae
    - match: '\.'
      scope: punctuation.accessor.felidae
    - match: ':'
      scope: punctuation.separator.key-value.felidae

  structures:
    - match: '[()]'
      scope: punctuation.section.group.felidae
    - match: '\{'
      scope: punctuation.section.mapping.begin.felidae
    - match: '\}'
      scope: punctuation.section.mapping.end.felidae
    - match: '\['
      scope: punctuation.section.sequence.begin.felidae
    - match: '\]'
      scope: punctuation.section.sequence.end.felidae
