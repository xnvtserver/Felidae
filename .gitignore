# Build outputs
build/
models/*.model
models/FelidaeSentencePieceIds.h
models/**/*.pt
models/**/manifest.txt
build-sentencepiece/
build-clang/
*.exe
*.obj
# Native module linker export files (including nested package folders)
native_modules/**/*.exp
# Linker export files generated anywhere else in the project
*.exp
*.lock
*.o
*.so
*.pdb
*.ilk
*.dll
*.lib
*.a

# Third-party sources are not tracked by default, but the vendored
# header-only dependencies ARE part of the build and must come with a clone.
# Without these negations `third_party/*` hides the header-only dependencies
# required by a fresh compiler/VM checkout.
third_party/*
!third_party/cpp-httplib/
!third_party/rapidcsv/
!third_party/Eigen/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# VS Code extension dependencies and package output
vs-code-extension/node_modules/
vs-code-extension/*.vsix
vs-code-extension/.vscode-test/

# IntelliJ IDEA extension generated files
intellij-idea-extension/.gradle/
intellij-idea-extension/.intellijPlatform/
intellij-idea-extension/build/

# Logs and temporary files
*.log
*.tmp
*.temp
*.fx.lock
# Generated documentation and visual assets stay ignored, while checked-in
# editor resources remain explicitly visible to Git.
*.html
*.svg
!**/resources/**/*.svg
!vs-code-extension/icons/*.svg
!vs-code-extension/themes/*.svg

# Editor/OS noise
.vs/
.idea/
out/
CMakeSettings.json
.DS_Store
Thumbs.db
desktop.ini
node_modules
