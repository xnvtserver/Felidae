import "html_components.fx".

DocsHosting() =>
    return (HtmlSectionData(id: "hosting", title: "Documentation Hosting", p: "This documentation site is itself a Felidae program. Each documentation aspect is a separate .fx module that returns a section fact. server.fx imports those modules, renders the section facts to HTML at runtime, indexes DocSearchEntry facts, and serves the generated page through the native C++ HTTP module.", p2: "For Ubuntu hosting, run ./build/felidae docs/server.fx as a private local service on 127.0.0.1:8090 and place Nginx in front of it. The docs server serves one deterministic SPA response; browser routing handles sections and search result links.", code: "import (\"http\" \"str\" \"html_components.fx\" \"docs_search.fx\" \"overview.fx\" \"facts.fx\" \"playground.fx\").\n\nDocsServerConfig() =>\n    return (host: \"127.0.0.1\", port: 8090, portText: \"8090\").\n\nmain() =>\n    config := DocsServerConfig(),\n    body := DocumentationBody(),\n    searchData := DocsSearchJson(),\n    html := RenderHtmlShell(body: body, searchData: searchData),\n    response := HttpHtmlResponse(body: html),\n    return (HttpServeResponse(host: config.host, port: config.port, response: response)).", note: "No PowerShell host process is required. The serving path is Felidae source -> C++ interpreter -> native cpp-httplib HTTP module -> Nginx reverse proxy.", code2: "Ubuntu service command:\ncd /opt/felidae/Felidae\n./build/felidae docs/server.fx\n\nNginx file:\ndocs/nginx/felidae-docs.conf\n\nSmoke test:\ncurl -fsS http://127.0.0.1:8090/ >/tmp/felidae-docs.html")).

