import "html_components.fx".

DocsFacts() =>
    guidance := RenderGuidance(doText: "Keep facts stable, named, and queryable. Use repeated fields for list-shaped values and nested objects for properties that belong together, such as an order item with sku, quantity, and price.", dontText: "Do not flatten related values into unclear names like item1Qty or item2Price. That makes filtering, aggregation, JSON export, and documentation search harder.", recommendText: "Treat a fact declaration as a small database row. Put repeatable queries in main() or named methods, and reserve command-line queries for quick inspection."),
    simulation := RenderNote(text: "Fact DB examples in the browser are a simulation of the storage model: Felidae can represent a database as .fx facts, similar to SQLite using a file or a graph database using graph-shaped records. The docs/db programs remain available for native interpreter workflows."),
    content := str.concat(left: guidance, right: simulation),
    return (HtmlRichSectionData(id: "facts", title: "Facts As Database", p: "Facts are the primary database layer. Named fields behave like logical properties, and repeated fields represent multi-valued properties.", p2: "Query a type directly with all, where, select, search, count, aggregates, conditional mutations, and keyed joins. Child facts remain assignable to parent queries.", content: content, code: "Customer(id: \"c-1\", name: \"Ada\", city: \"SEA\", active: 1.0).\nCustomer(id: \"c-2\", name: \"Mina\", city: \"BLR\", active: 1.0).\nOrder(id: \"o-1\", customer: \"c-1\", total: 40).\n\nmain() =>\n    customer := Customer.where(id: \"c-1\")\n    orders := Order.where(customer: \"c-1\")\n    return (customer: customer, orders: orders)\nend", note: "A fact-only .fx import is compiler-linked DDL. Conditional DML persists owned CSV and .fx rows automatically.", code2: "Animal(kind: \"cat\", legs: 4).\nPet extend Animal(name: \"Lilly\", kind: \"cat\").\n\nmain() =>\n    return Animal.where(kind: \"cat\")\nend")).
