import "html_components.fx".

DocsFacts() =>
    guidance := RenderGuidance(doText: "Keep facts stable, named, and queryable. Use repeated fields for list-shaped values and nested objects for properties that belong together, such as day id plus chance.", dontText: "Do not flatten related values into unclear names like day1Chance or mix unrelated meanings under the same field. That makes aggregation and probability analysis harder.", recommendText: "Treat a fact declaration as a small database row. If the row will be analyzed later, choose field names that can survive filtering, search, JSON export, and documentation rendering."),
    return (HtmlRichSectionData(id: "facts", title: "Facts As Database", p: "Facts are the primary database layer. Named fields behave like logical properties, and repeated fields represent multi-valued properties. Repeated fields materialize as arrays inside methods, so nested fact data can be mapped, filtered, aggregated, and passed to probability functions.", p2: "Use direct declarations for durable knowledge, globals for computed data, and methods when a value must be derived from input. Child facts can extend parent facts, and child fields override parent defaults. The db module exposes the loaded no-SQL fact store without asking users to write SQL.", content: guidance, code: "Rain(month: \"August\", day: {id: \"monday\", chance: 5.2}, day: {id: \"tuesday\", chance: 0.3}, day: {id: \"wednesday\", chance: 2.4}).\nRain(month: \"September\", day: {id: \"monday\", chance: 1.2}, day: {id: \"tuesday\", chance: 2.1}).\n\nmain() =>\n    report := db.first(type: \"Rain\", field: \"month\", equals: \"August\"),\n    chances := lambda(report.day, day => day.chance),\n    wetDays := lambda(report.day, day => day.chance > 1.0),\n    return (month: report.month, days: count(report.day), wetDays: count(wetDays), averageChance: average(chances)).", note: "The fact is the database row and the source code at the same time. Repeated fields are useful for names, tags, daily weather records, aliases, scores, and other list-shaped properties.", code2: "Animal(kind: \"cat\", legs: 4).\nPet extend Animal(name: \"Lilly\", kind: \"cat\").\n\nCat1(name: \"kitten\", name: \"tiger\", name: \"lilly\", name: \"sony\").\nCat2(name: \"joy\", name: \"teddy\", name: \"snowbell\").")).
