import "html_components.fx".

DocsFacts() =>
    guidance := RenderGuidance(doText: "Keep facts stable, named, and queryable. Use repeated fields for list-shaped values and nested objects for properties that belong together, such as an order item with sku, quantity, and price.", dontText: "Do not flatten related values into unclear names like item1Qty or item2Price. That makes filtering, aggregation, JSON export, and documentation search harder.", recommendText: "Treat a fact declaration as a small database row. Put repeatable queries in main() or named methods, and reserve command-line queries for quick inspection."),
    simulation := RenderNote(text: "Fact DB examples in the browser are a simulation of the storage model: Felidae can represent a database as .fx facts, similar to SQLite using a file or a graph database using graph-shaped records. The docs/db programs remain available for native interpreter workflows."),
    content := str.concat(left: guidance, right: simulation),
    return (HtmlRichSectionData(id: "facts", title: "Facts As Database", p: "Facts are the primary database layer. Named fields behave like logical properties, and repeated fields represent multi-valued properties. Repeated fields materialize as arrays inside methods, so nested fact data can be mapped, filtered, counted, sorted, and aggregated without SQL.", p2: "Use direct declarations for durable knowledge, globals for computed data, and methods when a value must be derived from input. Child facts can extend parent facts, and child fields override parent defaults. The db module exposes the loaded no-SQL fact store without asking users to write SQL or BigQuery.", content: content, code: "import \"db\".\n\nCustomer(id: \"c-1\", name: \"Ada\", city: \"SEA\", tag: \"active\", tag: \"enterprise\").\nCustomer(id: \"c-2\", name: \"Mina\", city: \"BLR\", tag: \"active\").\nOrder(id: \"o-1\", customer: \"c-1\", item: {sku: \"book\", qty: 2, price: 15}, item: {sku: \"pen\", qty: 5, price: 2}).\n\nmain() =>\n    customer := db.first(type: \"Customer\", field: \"id\", equals: \"c-1\"),\n    order := db.first(type: \"Order\", field: \"customer\", equals: customer.id),\n    quantities := lambda(order.item, item => item.qty),\n    return (customer: customer.name, tags: customer.tag, itemCount: count(order.item), totalUnits: sum(quantities)).", note: "The fact is the database row and the source code at the same time. Browser examples show the generated fact-file shape for learning; production file I/O should use the native Felidae interpreter.", code2: "Animal(kind: \"cat\", legs: 4).\nPet extend Animal(name: \"Lilly\", kind: \"cat\").\n\nmain() =>\n    pets := lambda(Pet, p => p.kind == \"cat\"),\n    return (cats: pets, count: count(pets)).")).
