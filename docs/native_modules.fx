import "html_components.fx".

DocsNativeModules() =>
    guidance := RenderGuidance(doText: "Expose native capabilities through small core declarations, validate arguments at the Felidae boundary, and layer friendly helper methods above raw native calls.", dontText: "Do not make application pages call native primitives directly when a helper method can return a clearer data shape.", recommendText: "Keep native modules boring and stable: declarations are the contract, C++ owns performance or I/O, and Felidae helpers own composable application data."),
    return (HtmlRichSectionData(id: "native", title: "Native Modules", p: "Felidae keeps the interpreter small by treating native libraries as runtime modules. An import first loads the declaration file from core/, then resolves the matching platform implementation when needed. A core file may contain both native declarations and ordinary Felidae helper methods.", p2: "Native modules export a small C ABI: felidae_native_call(function_name, args_json) and felidae_native_free(ptr). Felidae validates concrete argument values against the declaration before calling native code, so bad argument shapes fail in the interpreter before reaching the shared library. Dotted names such as http.serveStatic map to native calls; helper methods such as HttpServeResponse are regular Felidae methods layered above them.", content: guidance, code: "import \"csv\".\nimport \"http\".\n\n# Native declaration shape in core/csv.fx\ncsv.parse(data: string, access: array) => ().\n\n# Native declaration plus Felidae helpers in core/http.fx\nhttp.serveStatic(host: string, port: int, response: string, contentType: string) => ().\nHttpHtmlResponse(body: string) =>\n    return (HttpResponse(status: 200, contentType: \"text/html\", body: body)).", note: "Resolver locations include native_modules/<module>/ and modules/<module>/. Use core declarations for the public Felidae surface, native libraries for implementation, and helper methods for reusable application shapes.", code2: "Windows: csv.dll, felidae_csv.dll\nLinux: libcsv.so, libfelidae_csv.so, csv.so\nmacOS: libcsv.dylib, libfelidae_csv.dylib, csv.dylib\n\nNative return JSON can bind result, access, out, or value depending on the declaration.")).
