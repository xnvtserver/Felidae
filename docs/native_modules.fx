import "html_components.fx".

DocsNativeModules() =>
    guidance := RenderGuidance(doText: "Use compiler-known operations that lower to verified Builtin IR, and provide host services explicitly when an operation needs external state.", dontText: "Do not depend on the retired felidae_native_call JSON ABI or assume that importing a module loads a shared library.", recommendText: "Keep one typed C++ implementation under src/form/libs for each deterministic runtime library operation."),
    return (HtmlRichSectionData(id: "native", title: "Runtime Libraries", p: "The production compiler and RegisterVm do not load native-extension DLLs. Deterministic library calls such as json, csv, and finite-group checks are encoded as Builtin instructions in FELBIR and dispatched directly to typed C++ functions.", p2: "A runtime must reject an operation when a required external service is absent. The native_modules directory contains only migration sources that are excluded from normal builds and must be removed after equivalent direct-IR behavior passes compiler-to-VM tests.", content: guidance, code: "import (\"json\", \"csv\").\n\nmain() =>\n    value := json.parse(data: \"{\\\"name\\\":\\\"Ada\\\"}\"),\n    rows := csv.parse(data: \"name,score\\nAda,42\\n\"),\n    return (name: json.get(data: value, key: \"name\"), rows: rows).", note: "Builtin operation IDs and arities are shared by the compiler, verifier, and VM. Ordinary deterministic operations never invoke an SSM.", code2: "source.fx -> IntegerParser -> AST -> verified FELBIR -> RegisterVm -> src/form/libs")).
