import "html_components.fx".

DocsMethods() =>
    guidance := RenderGuidance(doText: "Pass inputs into methods with named arguments, keep local values immutable with :=, and return named tuples that can be inspected by users and tests.", dontText: "Do not write a method as if a bare fact pattern inside it will magically scan every fact row. Make scans explicit with db.find, db.all, or lambda(FactType, row => ...).", recommendText: "Use main() as the public workflow. Put reusable transformations in named methods, then call those methods from main() so examples and server responses stay deterministic."),
    return (HtmlRichSectionData(id: "methods", title: "Rules, Methods, And Returns", p: "Rules describe relationships that can be satisfied by facts. Methods are the best place to write application queries: collect fact rows, filter them, aggregate them, and return a named tuple from main() or another method. This makes the query repeatable instead of leaving it only as a terminal command.", p2: "Methods use strict named arguments and immutable values. A method processes the inputs passed to it; it does not implicitly iterate over the fact database. Use db helpers or lambda(Type, item => ...) when you intentionally want fact iteration. Fallback branches are ordered logic alternatives, and the first branch that returns a result wins.", content: guidance, code: "Person(name: \"Ada\", role: \"Engineer\").\nPerson(name: \"Mina\", role: \"Designer\").\n\nIsEngineer(person: any) =>\n    person.role == \"Engineer\",\n    return (name: person.name, allowed: \"true\")\nelse\n    return (name: person.name, allowed: \"false\").\n\nmain() =>\n    checks := lambda(Person, p => IsEngineer(person: p)),\n    allowed := lambda(checks, row => row.allowed == \"true\"),\n    return (total: count(checks), engineers: allowed).", note: "Use command-line queries when you want to inspect facts quickly. Use main() when the query is part of the program, an example, a test, or a documentation page.", code2: "Score(input: any) =>\n    where input.value >= 10,\n    return (label: \"high\", value: input.value)\nelse\n    return (label: \"low\", value: input.value).\n\nmain() =>\n    result := Score(input: {value: 12}),\n    message := str.concat(left: result.label, right: \" score\"),\n    return (message: message, score: result).")).
