import "html_components.fx".

DocsProbability() =>
    guidance := RenderGuidance(doText: "Derive numeric arrays from facts, then pass those arrays to probability functions. Return the raw rows, derived arrays, and probability results together when the output needs to be auditable.", dontText: "Do not overwrite the source facts with computed probabilities. Keep the original facts as the database of record and compute distributions inside methods.", recommendText: "For similarity work, normalize both sides into comparable arrays first. Return overlap, difference, and confidence-like scores as named fields rather than an unnamed list."),
    return (HtmlRichSectionData(id: "probability", title: "Probability On Facts", p: "Probability functions operate on arrays derived from facts. This lets Felidae treat a fact database as a statistical dataset without SQL or BigQuery. Useful helpers include mean, variance, stddev, normalize, entropy, covariance, correlation, Bernoulli, binomial, Poisson, normal, uniform, sample, and weightedChoice.", p2: "For similarity-style programs, convert facts into comparable arrays, score overlap or distance, then return a tuple of probabilities. For weather, logs, rankings, and entity comparison, keep raw values in facts and derive distributions inside methods.", content: guidance, code: "import (\"db\" \"probability\").\n\nRain(month: \"August\", day: {id: \"monday\", chance: 5.2}, day: {id: \"tuesday\", chance: 0.3}, day: {id: \"wednesday\", chance: 2.4}).\nmain() =>\n    record := db.first(type: \"Rain\", field: \"month\", equals: \"August\"),\n    chances := lambda(record.day, day => day.chance),\n    distribution := probability.normalize(data: chances),\n    spread := probability.stddev(data: chances),\n    entropy := probability.entropy(data: distribution),\n    return (month: record.month, values: chances, distribution: distribution, spread: spread, entropy: entropy).", note: "The probability library consumes ordinary Felidae arrays, so facts stay as the database of record. This keeps analysis reproducible because the same source file contains both the facts and the transformation.", code2: "import (\"db\" \"math\").\n\nCat1(name: \"kitten\", name: \"tiger\", name: \"lilly\", name: \"sony\").\nCat2(name: \"joy\", name: \"teddy\", name: \"snowbell\").\nCompareCats() =>\n    left := db.first(type: \"Cat1\"),\n    right := db.first(type: \"Cat2\"),\n    total := count(left.name) + count(right.name),\n    difference := math.abs(value: count(left.name) - count(right.name)) / total,\n    return (leftShare: count(left.name) / total, rightShare: count(right.name) / total, difference: difference).")).
