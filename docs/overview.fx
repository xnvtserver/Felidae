import "html_components.fx".

DocsOverview() =>
    guidance := RenderGuidance(doText: "Read facts as both source code and data rows. Keep examples runnable, and return useful results from main() so users can verify behavior immediately.", dontText: "Do not describe Felidae as a SQL wrapper. The database is the loaded fact base, and queries are ordinary Felidae methods, rules, lambdas, and aggregates.", recommendText: "For first-time users, follow this path: Basics, Start, Syntax, Facts DB, Queries, Methods, Probability, Server, Debugging, then Download."),
    return (HtmlRichSectionData(id: "overview", title: "Overview", p: "Felidae is a functional logic language where code and data share the same shape. Facts are executable knowledge: they can be queried, transformed, aggregated, searched, rendered into documentation, and analyzed by libraries without translating them into SQL.", p2: "If you are new, read Basics, Start, Syntax, Facts DB, Queries, and Methods first. Use Standard Library and Library Index when choosing APIs, then open the focused module page for signatures, examples, and operational cautions.", content: guidance, code: "Person(name: \"Alice\", role: \"Engineer\", office: \"SEA\").\nPerson(name: \"Mina\", role: \"Designer\", office: \"BLR\").\nPerson(name: \"Ravi\", role: \"Engineer\", office: \"BLR\").\n\nmain() =>\n    engineers := lambda(Person, p => p.role == \"Engineer\"),\n    offices := sort(lambda(engineers, p => p.office)),\n    return (engineerCount: count(engineers), offices: offices).", note: "The overview stays stable and short. Detailed API risks, host access warnings, and module-specific behavior belong on the relevant module page.", code2: "DocsOverview() =>\n    return (HtmlSectionData(\n        id: \"overview\",\n        title: \"Overview\",\n        p: \"Felidae facts are executable data.\",\n        code: \"Person(name: \\\"Alice\\\").\"\n    )).\n\nDocSearchEntry(id: \"overview\", title: \"Overview\", route: \"#overview\").")).
