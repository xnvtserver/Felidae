import "html_components.fx".

DocsOverview() =>
    guidance := RenderGuidance(doText: "Read facts as both source code and data rows. Keep examples runnable, and return useful results from main() so users can verify behavior immediately.", dontText: "Do not describe Felidae as a SQL wrapper. The database is the loaded fact base, and queries are ordinary Felidae methods, rules, lambdas, and aggregates.", recommendText: "For first-time users, follow this path: Basics, Start, Syntax, Facts DB, Queries, Methods, Probability, Server, Debugging, then Download."),
    return (HtmlRichSectionData(id: "overview", title: "Overview", p: "Felidae is a functional logic language where code and data share the same shape. Facts are executable knowledge: they can be queried directly, loaded as data, transformed inside methods, aggregated, analyzed, routed into documentation pages, searched as documentation facts, and passed to probability or ML helpers.", p2: "Read this documentation in order if you are new: Basics explains logic programming, Start shows commands, Syntax explains the surface language, Facts and Queries explain the database model, then Methods, Libraries, Native, Debugging, Download, and Version fill in the product details. Use the search bar when you already know the topic name.", content: guidance, code: "Person(name: \"Alice\", role: \"Engineer\", office: \"SEA\").\nPerson(name: \"Mina\", role: \"Designer\", office: \"BLR\").\nPerson(name: \"Ravi\", role: \"Engineer\", office: \"BLR\").\n\nmain() =>\n    engineers := lambda(Person, p => p.role == \"Engineer\"),\n    offices := sort(lambda(engineers, p => p.office)),\n    return (engineerCount: count(engineers), offices: offices).", note: "Code is data and data is code: a declaration can be queried as a fact, rendered as documentation, indexed for search, or consumed by a method without translating it into SQL.", code2: "DocsOverview() =>\n    return (HtmlSectionData(\n        id: \"overview\",\n        title: \"Overview\",\n        p: \"Felidae facts are executable data.\",\n        code: \"Person(name: \\\"Alice\\\").\"\n    )).\n\nDocSearchEntry(id: \"overview\", title: \"Overview\", route: \"#overview\").")).
