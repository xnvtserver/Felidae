import "html_components.fx".

DocsDebugging() =>
    guidance := RenderGuidance(doText: "Run --check-json in automation, use Celidae for editor diagnostics, and smoke test docs/server examples with the same binaries users will run.", dontText: "Do not add a second semantic validator in the editor extension or docs scripts. Parallel validators drift and produce false Problems for valid Felidae syntax.", recommendText: "When a diagnostic message changes, update examples, docs, and extension packaging notes in the same pass so runtime behavior and user-facing guidance stay aligned."),
    return (HtmlRichSectionData(id: "debugging", title: "Debugging And Editor Diagnostics", p: "Celidae owns language diagnostics, visual analytics, fact-database profiling, and editor-facing checks. Editor integrations should call Celidae instead of duplicating semantic validation in TypeScript or another parser.", p2: "Use --check-json in automation so syntax, imports, fact iteration mistakes, and module resolution errors are reported by the same runtime-aware checker used by editor diagnostics. Use graph and visualize commands when the question is about loaded facts and data flow, not just syntax.", content: guidance, code: "./build/celidae examples/main.fx --check-json\n./build/celidae examples/main.fx --inspect-graph\n./build/celidae examples/main.fx --visualize-data-json --load-imports\n./build/celidae examples/main.fx --visualize-data-html --load-imports\n./build/celidae --lsp", note: "Diagnostics should stay owned by the runtime-aware checker. Documentation examples should be validated with the same checker so docs, editor Problems, and runtime wording do not drift.", code2: "./build/celidae docs/server.fx --check-json\n./build/felidae docs/server.fx\n# open http://127.0.0.1:8090/#overview")).
