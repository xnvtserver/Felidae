import "html_components.fx".

DocsDebugging() =>
    guidance := RenderGuidance(doText: "Run --check-json in automation, use felidae_debug for editor diagnostics, and smoke test docs/server examples with the same binaries users will run.", dontText: "Do not add a second semantic validator in the editor extension or docs scripts. Parallel validators drift and produce false Problems for valid Felidae syntax.", recommendText: "When a diagnostic message changes, update examples, docs, and extension packaging notes in the same pass so runtime behavior and user-facing guidance stay aligned."),
    return (HtmlRichSectionData(id: "debugging", title: "Debugging And Editor Diagnostics", p: "felidae_debug owns parser diagnostics, AST analysis, and editor-facing checks. Celidae owns non-programmatic fact relationship visualization. Editor integrations should call felidae_debug instead of duplicating parser or AST validation in TypeScript or another parser.", p2: "Use felidae_debug --check-json in automation so syntax and AST issues such as unused declarations, duplicate facts, and invalid data flow are reported by the same AST analyzer used by editor diagnostics. Use graph and visualize commands when the question is about loaded facts and data flow, not just syntax.", content: guidance, code: "./build/felidae_debug examples/main.fx --check-json\n./build/celidae examples/main.fx --inspect-graph\n./build/celidae examples/main.fx --json --load-imports\n./build/celidae examples/main.fx --html --load-imports\n./build/felidae_debug --lsp", note: "Diagnostics should stay owned by the AST analyzer. Documentation examples should be validated with the same checker so docs, editor Problems, and runtime wording do not drift.", code2: "./build/felidae_debug docs/server.fx --check-json\n./build/felidae docs/server.fx\n# open http://127.0.0.1:8090/#overview")).
