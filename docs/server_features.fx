import "html_components.fx".

DocsServerFeatures() =>
    guidance := RenderGuidance(doText: "Generate HTML from .fx modules, keep route ids stable, log startup URL information, validate docs with Celidae, and run the server as a private local process behind Nginx.", dontText: "Do not add PowerShell, cmd.exe, or shell-specific wrappers to the production server path. The deployable server should be the C++ Felidae binary running docs/server.fx.", recommendText: "For production hosting, bind Felidae to 127.0.0.1:8090, proxy public traffic through docs/nginx/felidae-docs.conf, keep SPA hash routes stable, and smoke test the generated page after every docs change."),
    return (HtmlRichSectionData(id: "server", title: "Server Features", p: "The docs server is a Felidae program that renders documentation data at startup and serves a single HTML application through the native C++ HTTP implementation. Client-side routing handles navigation between documentation routes, while the server keeps the response deterministic and easy to host.", p2: "Current server features include generated HTML from .fx modules, hash/path route resolution, active navigation state, searchable documentation facts, copyable code boxes, a browser playground, startup logging, and a static HTTP response suitable for deployment behind Nginx. core/http.fx provides Http* helper methods over the native HTTP bridge.", content: guidance, code: "DocsServerConfig() =>\n    return (host: \"127.0.0.1\", port: 8090, portText: \"8090\").\n\nmain() =>\n    config := DocsServerConfig(),\n    body := DocumentationBody(),\n    searchData := DocsSearchJson(),\n    html := RenderHtmlShell(body: body, searchData: searchData),\n    response := HttpHtmlResponse(body: html),\n    return (HttpServeResponse(host: config.host, port: config.port, response: response)).", note: "Routes are browser routes over a generated static document today. The search bar uses DocSearchEntry facts generated by docs_search.fx. The native server returns one generated response for GET, POST, PUT, and DELETE at /. A future request-router module can map /docs/:page to the same route ids on the server side.", code2: "Ubuntu run:\n./build/felidae docs/server.fx\n\nNginx reverse proxy:\nsudo cp docs/nginx/felidae-docs.conf /etc/nginx/sites-available/felidae-docs\nsudo ln -s /etc/nginx/sites-available/felidae-docs /etc/nginx/sites-enabled/felidae-docs\nsudo nginx -t\nsudo systemctl reload nginx\n\nRoute examples:\n/docs#overview\n/docs#facts\n/docs#server\n/docs#playground")).
