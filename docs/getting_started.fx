import "html_components.fx".

DocsGettingStarted() =>
    guidance := RenderGuidance(doText: "Create a .fx file, add a few facts, write main(), run ./build/felidae, then run Celidae with --check-json before sharing the program.", dontText: "Do not start by depending on ad hoc terminal queries for core behavior. They are great for inspection, but main() is the stable program contract.", recommendText: "Keep a tiny smoke example near every new feature. A good smoke example has facts, one transformation, one aggregate, and a named return tuple."),
    return (HtmlRichSectionData(id: "start", title: "Getting Started", p: "A Felidae program is a set of facts, rules, methods, imports, and usually a main method. Start by putting the query or workflow you care about in main(), because that makes the result repeatable, checkable, and easy to document.", p2: "Command-line queries are still supported for quick fact inspection, but main() and named methods are the primary place for application logic. Use Felidae for execution, felidae_debug for parser and AST checks, and Celidae for fact relationship visualization. Windows release binaries use .exe names; Linux hosting uses ./build/felidae and ./build/celidae.", content: guidance, code: "./build/felidae docs/server.fx\n./build/felidae examples/main.fx\n./build/felidae_debug examples/main.fx --check-json\n./build/celidae examples/main.fx --inspect-graph\n\n# Optional fact inspection:\n./build/felidae examples/main.fx '? Person(name: Name)'", note: "Use CLI queries when you want to inspect facts in parallel with development. Use main() when the query is part of the program, docs, tests, examples, or a server response.", code2: "Person(name: \"Alice\", role: \"Engineer\").\nPerson(name: \"Mina\", role: \"Designer\").\n\nmain() =>\n    engineers := lambda(Person, p => p.role == \"Engineer\"),\n    return (status: \"ready\", count: count(engineers), rows: engineers).")).
