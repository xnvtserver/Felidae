import "html_components.fx".

DocsPlayground() =>
    return (HtmlPlaygroundData(id: "playground", title: "Playground", p: "Edit a Felidae sample and run it in the browser through the WASM interpreter generated from the C++ runtime. You can still copy or download the same source and run it with the native CLI.", example: "RainDay(month: \"August\", day: \"monday\", chance: 5.2).\nRainDay(month: \"August\", day: \"tuesday\", chance: 0.3).\nRainDay(month: \"August\", day: \"wednesday\", chance: 2.4).\nCat1(name: \"kitten\").\nCat1(name: \"tiger\").\nCat1(name: \"lilly\").\nCat1(name: \"sony\").\nCat2(name: \"joy\").\nCat2(name: \"teddy\").\nCat2(name: \"snowbell\").\n\nCompareCats() =>\n    leftCount := Cat1.count(),\n    rightCount := Cat2.count(),\n    total := leftCount + rightCount,\n    return (leftShare: leftCount / total, rightShare: rightCount / total, difference: (leftCount - rightCount) / total).\n\nmain() =>\n    august := RainDay.where(month: \"August\"),\n    averageChance := RainDay.average(field: \"chance\", match: {month: \"August\"}),\n    return (days: august, averageChance: averageChance, cats: CompareCats()).", command: "./build/debug/felidae_vm build/debug/felidae-snippet.bin", note: "Compile the snippet into build/debug first. The browser version loads docs/wasm/felidae_wasm.js; build those assets in a named build subdirectory, then refresh the page." )).
