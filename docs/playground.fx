import "html_components.fx".

DocsPlayground() =>
    return (HtmlPlaygroundData(id: "playground", title: "Playground", p: "Edit a Felidae sample and run it in the browser through the WASM interpreter generated from the C++ runtime. You can still copy or download the same source and run it with the native CLI.", example: "import (\"db\" \"probability\").\n\nRain(month: \"August\", day: {id: \"monday\", chance: 5.2}, day: {id: \"tuesday\", chance: 0.3}, day: {id: \"wednesday\", chance: 2.4}).\nCat1(name: \"kitten\").\nCat1(name: \"tiger\").\nCat1(name: \"lilly\").\nCat1(name: \"sony\").\nCat2(name: \"joy\").\nCat2(name: \"teddy\").\nCat2(name: \"snowbell\").\n\nCompareCats() =>\n    leftRows := db.all(type: \"Cat1\"),\n    rightRows := db.all(type: \"Cat2\"),\n    total := count(leftRows) + count(rightRows),\n    return (leftShare: count(leftRows) / total, rightShare: count(rightRows) / total, difference: (count(leftRows) - count(rightRows)) / total).\n\nmain() =>\n    rain := db.first(type: \"Rain\", field: \"month\", equals: \"August\"),\n    chances := lambda(rain.day, d => d.chance),\n    distribution := probability.normalize(data: chances),\n    return (month: rain.month, rainDistribution: distribution, cats: CompareCats()).", command: "./build/felidae felidae-snippet.fx", note: "Run loads docs/wasm/felidae_wasm.js. Build those assets with .\\build\\felidae.exe wasm.fx on Windows or ./build/felidae wasm.fx on Linux/macOS, then refresh the docs page.")).

