import "html_components.fx".

DocsPlayground() =>
    return (HtmlPlaygroundData(id: "playground", title: "Playground", p: "Edit a Felidae sample, copy it into a local .fx file, and run it with the generated command. The current documentation server is static, so execution stays local while the playground keeps examples close to the docs.", example: "import (\"db\" \"probability\").\n\nRain(month: \"August\", day: {id: \"monday\", chance: 5.2}, day: {id: \"tuesday\", chance: 0.3}, day: {id: \"wednesday\", chance: 2.4}).\nCat1(name: \"kitten\", name: \"tiger\", name: \"lilly\", name: \"sony\").\nCat2(name: \"joy\", name: \"teddy\", name: \"snowbell\").\n\nCompareCats() =>\n    left := db.first(type: \"Cat1\"),\n    right := db.first(type: \"Cat2\"),\n    total := count(left.name) + count(right.name),\n    return (leftShare: count(left.name) / total, rightShare: count(right.name) / total).\n\nmain() =>\n    rain := db.first(type: \"Rain\", field: \"month\", equals: \"August\"),\n    chances := lambda(rain.day, d => d.chance),\n    return (rainDistribution: probability.normalize(data: chances), cats: CompareCats()).", command: "./build/felidae playground.fx", note: "The playground is generated from a Felidae playground fact and rendered by html_components.fx. Copy Program writes the current editor text to your clipboard; Copy Run Command copies the local command.")).
