import "html_components.fx".

DocsQueries() =>
    guidance := RenderGuidance(doText: "Put production queries in main() or named methods, return named tuples, and keep aggregate inputs visible near the aggregate call.", dontText: "Do not rely on a terminal query as the only record of business logic. Also avoid implicit fact iteration inside methods; use lambda(Type, row => ...) or db helpers intentionally.", recommendText: "Use CLI queries in parallel while developing, then move the final workflow into the .fx file so Celidae, docs, tests, and users all see the same behavior."),
    return (HtmlRichSectionData(id: "queries", title: "Queries And Aggregates", p: "Prefer writing reusable queries inside main() or named methods. That keeps the program accountable: inputs, derived facts, aggregate calls, and return values all live in the same .fx file and can be checked by Celidae. Command-line queries are still supported, but they are best for quick inspection of loaded facts.", p2: "Inside methods, queries are explicit: use lambda(Type, item => ...) for fact iteration or the db module for no-SQL fact-store access. Available aggregate-style helpers include count, average, sum, min, max, sort, search, contains, lower, upper, and length. The db module exposes db.all, db.find, db.first, db.count, db.types, and db.fields.", content: guidance, code: "Customer(name: \"Ada\", city: \"SEA\", status: \"active\").\nCustomer(name: \"Mina\", city: \"BLR\", status: \"active\").\nCustomer(name: \"Ravi\", city: \"SEA\", status: \"inactive\").\n\nmain() =>\n    sea := db.find(type: \"Customer\", field: \"city\", equals: \"SEA\"),\n    activeSea := lambda(sea, row => row.status == \"active\"),\n    names := sort(lambda(activeSea, row => row.name)),\n    return (count: count(activeSea), names: names).", note: "CLI query mode stays useful for ad hoc inspection, for example ./build/felidae customers.fx '? Customer(name: Name, city: \"SEA\")'. For application behavior and documentation examples, prefer main() or named methods.", code2: "./build/felidae docs/server.fx '? DocSearchEntry(id: Id, title: Title)'\n\nSearchDocumentation(query: string) =>\n    normalized := str.lower(data: query),\n    matches := lambda(DocSearchEntry, entry => SearchDocumentationResult(entry: entry, query: normalized)),\n    return (query: query, count: count(matches), results: matches).")).
