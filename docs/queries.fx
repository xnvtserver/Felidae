import "html_components.fx".

DocsQueries() =>
    guidance := RenderGuidance(doText: "Put production queries in main() or named methods, return named tuples, and keep aggregate inputs visible near the aggregate call.", dontText: "Do not rely on a terminal query as the only record of business logic or route facts through a retired db namespace.", recommendText: "Use Type.where for exact fields and Type.search for text, regex, hierarchy, or degree matching."),
    return (HtmlRichSectionData(id: "queries", title: "Queries And Aggregates", p: "Reusable queries keep inputs, derived facts, aggregates, and returned evidence together in the .fx program.", p2: "Fact types expose all, where, select, search, count, numeric aggregates, conditional mutations, and keyed joins directly.", content: guidance, code: "Customer(name: \"Ada\", city: \"SEA\", active: 1.0).\nCustomer(name: \"Mina\", city: \"BLR\", active: 1.0).\nCustomer(name: \"Ravi\", city: \"SEA\", active: 0.0).\n\nmain() =>\n    activeSea := Customer.where(city: \"SEA\").AndWhere(active: 1.0)\n    return (count: count(data: activeSea), rows: activeSea)\nend", note: "Updates and deletes must follow a conditional where chain; joins require both key fields.", code2: "Customer.where(city: \"SEA\").limit(records: 100)\nCustomer.search(field: \"name\", query: \"%ad%\", type: \"like\")\nCustomer.average(field: \"score\", match: {active: 1.0})")).
