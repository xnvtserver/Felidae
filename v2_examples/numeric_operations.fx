main() =>
    return (
        minimum: min(0.8, 0.3),
        maximum: max(0.8, 0.3),
        absolute: abs(-4.5),
        difference: diff(8.2, 5.0),
        average: avg(10.0, 20.0),
        weightedAverage: weighted_avg(10.0, 20.0, 1.0, 3.0),
        clamped: clamp(1.4, 0.0, 1.0),
        floor: floor(4.8),
        ceil: ceil(4.2),
        rounded: round(4.6),
        truncated: trunc(4.8),
        squareRoot: sqrt(9.0),
        cubeRoot: cbrt(8.0),
        power: pow(2.0, 3.0),
        exponential: exp(0.0),
        naturalLog: log(1.0),
        decimalLog: log10(1000.0),
        modulo: mod(7.5, 2.0),
        interpolated: lerp(10.0, 20.0, 0.25),
        sign: sign(-7.2),
        reciprocal: reciprocal(4.0),
        square: square(3.0),
        cube: cube(2.0),
        inRange: in_range(0.7, 0.0, 1.0),
        finite: is_finite(1.5),
        nan: is_nan(1.5)
    )
