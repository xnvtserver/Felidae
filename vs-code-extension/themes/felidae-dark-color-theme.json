{
  "$schema": "vscode://schemas/color-theme",
  "name": "Felidae Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0b1412",
    "editor.foreground": "#d6e5e1",
    "editorLineNumber.foreground": "#3d5450",
    "editorLineNumber.activeForeground": "#18f0d7",
    "editorCursor.foreground": "#18f0d7",
    "editor.selectionBackground": "#18f0d733",
    "editor.selectionHighlightBackground": "#18f0d71f",
    "editor.lineHighlightBackground": "#12201d",
    "editorWhitespace.foreground": "#22332f",
    "editorIndentGuide.background1": "#1c2b28",
    "editorIndentGuide.activeBackground1": "#2f4a45",
    "editorBracketMatch.background": "#18f0d726",
    "editorBracketMatch.border": "#18f0d780",
    "sideBar.background": "#091110",
    "sideBar.foreground": "#b9cdc9",
    "activityBar.background": "#070e0d",
    "activityBar.foreground": "#18f0d7",
    "statusBar.background": "#070e0d",
    "statusBar.foreground": "#9fb5b1",
    "titleBar.activeBackground": "#070e0d",
    "titleBar.activeForeground": "#d6e5e1",
    "tab.activeBackground": "#12201d",
    "tab.activeForeground": "#e8f5f2",
    "tab.inactiveBackground": "#091110",
    "tab.activeBorderTop": "#18f0d7",
    "panel.background": "#091110",
    "terminal.background": "#0b1412",
    "terminal.foreground": "#d6e5e1",
    "editorWidget.background": "#12201d",
    "editorSuggestWidget.background": "#12201d",
    "editorSuggestWidget.selectedBackground": "#1d3531",
    "editorHoverWidget.background": "#12201d",
    "editorError.foreground": "#f2637e",
    "editorWarning.foreground": "#f7c948",
    "editorInfo.foreground": "#6ca8ff",
    "focusBorder": "#18f0d766"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.line.number-sign.felidae"],
      "settings": { "foreground": "#5c7a75", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted.double.Felidae"],
      "settings": { "foreground": "#9ede8a" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape.Felidae"],
      "settings": { "foreground": "#f7c948" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric.Felidae"],
      "settings": { "foreground": "#f7a93f" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword.control.felidae"],
      "settings": { "foreground": "#ff8ec0", "fontStyle": "bold" }
    },
    {
      "name": "Import keyword",
      "scope": ["keyword.control.import.Felidae"],
      "settings": { "foreground": "#ff8ec0", "fontStyle": "bold" }
    },
    {
      "name": "Rule and query operators",
      "scope": ["keyword.operator.rule.Felidae", "keyword.operator.query.Felidae"],
      "settings": { "foreground": "#18f0d7", "fontStyle": "bold" }
    },
    {
      "name": "Comparison and arithmetic operators",
      "scope": [
        "keyword.operator.comparison.Felidae",
        "keyword.operator.arithmetic.Felidae"
      ],
      "settings": { "foreground": "#7fd8ff" }
    },
    {
      "name": "Conjunction and disjunction",
      "scope": [
        "keyword.operator.logical.and.Felidae",
        "keyword.operator.logical.or.Felidae"
      ],
      "settings": { "foreground": "#c4a2ff" }
    },
    {
      "name": "Fact and method declarations",
      "scope": ["entity.name.function.predicate.Felidae"],
      "settings": { "foreground": "#18f0d7" }
    },
    {
      "name": "Standard-library modules",
      "scope": ["support.class.library.felidae"],
      "settings": { "foreground": "#ffb86b" }
    },
    {
      "name": "Standard-library functions",
      "scope": ["support.function.library.felidae"],
      "settings": { "foreground": "#6ca8ff" }
    },
    {
      "name": "Primitive type annotations",
      "scope": ["storage.type.primitive.felidae"],
      "settings": { "foreground": "#f7c948", "fontStyle": "italic" }
    },
    {
      "name": "Named-argument separator",
      "scope": ["punctuation.separator.key-value.Felidae"],
      "settings": { "foreground": "#7f9a95" }
    },
    {
      "name": "Accessors",
      "scope": [
        "punctuation.accessor.felidae",
        "punctuation.accessor.library.felidae",
        "punctuation.accessor.module.Felidae"
      ],
      "settings": { "foreground": "#7f9a95" }
    },
    {
      "name": "Brackets and groups",
      "scope": [
        "punctuation.definition.group.Felidae",
        "punctuation.definition.map.Felidae",
        "punctuation.definition.array.Felidae"
      ],
      "settings": { "foreground": "#9fb5b1" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid.illegal.comment.unsupported-slash.felidae"],
      "settings": { "foreground": "#f2637e", "fontStyle": "underline" }
    }
  ]
}
