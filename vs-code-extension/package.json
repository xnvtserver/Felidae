{
  "name": "felidae-vscode",
  "displayName": "Felidae",
  "description": "Felidae .fx support with AST debugger diagnostics and Celidae fact visualization.",
  "version": "0.0.2",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/xnvtserver/Felidae.git"
  },
  "homepage": "https://github.com/xnvtserver/Felidae/tree/main/vs-code-extension",
  "bugs": {
    "url": "https://github.com/xnvtserver/Felidae/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:felidae",
    "onCommand:felidae.runMain",
    "onCommand:felidae.debugMain",
    "onCommand:felidae.runQuery",
    "onCommand:felidae.visualize",
    "onDebugInitialConfigurations:felidae",
    "onDebugResolve:felidae"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "felidae",
        "aliases": [
          "Felidae",
          "Felidae Logic",
          "felidae"
        ],
        "extensions": [
          ".fx"
        ],
        "icon": {
          "light": "./icons/fx-light.svg",
          "dark": "./icons/fx-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "felidae-icons",
        "label": "Felidae File Icons",
        "path": "./icons/felidae-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.fx": "felidae"
      }
    },
    "breakpoints": [
      {
        "language": "felidae"
      }
    ],
    "grammars": [
      {
        "language": "felidae",
        "scopeName": "source.felidae",
        "path": "./syntaxes/felidae.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "felidae",
        "path": "./snippets/felidae.json"
      }
    ],
    "commands": [
      {
        "command": "felidae.runMain",
        "title": "Felidae: Run",
        "icon": "$(play)"
      },
      {
        "command": "felidae.debugMain",
        "title": "Felidae: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "felidae.runQuery",
        "title": "Felidae: Run Query",
        "icon": "$(terminal)"
      },
      {
        "command": "felidae.visualize",
        "title": "Felidae: Visualize",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "debuggers": [
      {
        "type": "felidae",
        "label": "Felidae",
        "languages": [
          "felidae"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Felidae source file to run.",
                "default": "${file}"
              },
              "query": {
                "type": "string",
                "description": "Optional Felidae query to execute. Omit to run main(...).",
                "default": "? Engineer(name: name)"
              },
              "interpreterPath": {
                "type": "string",
                "description": "Path to the Felidae AST debugger executable.",
                "default": "${workspaceFolder}/build/felidae_debug.exe"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before executing the program so VS Code Continue resumes Celidae.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "felidae",
            "request": "launch",
            "name": "Debug Felidae Main",
            "program": "${file}",
            "interpreterPath": "${workspaceFolder}/build/felidae_debug.exe",
            "stopOnEntry": true
          },
          {
            "type": "felidae",
            "request": "launch",
            "name": "Debug Felidae Query",
            "program": "${file}",
            "query": "? Engineer(name: name)",
            "interpreterPath": "${workspaceFolder}/build/felidae_debug.exe",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "configuration": {
      "title": "Felidae",
      "properties": {
        "felidae.interpreterPath": {
          "type": "string",
          "default": "build/felidae.exe",
          "description": "Path to the Felidae interpreter executable. Relative paths are resolved from the workspace folder."
        },
        "felidae.defaultQuery": {
          "type": "string",
          "default": "? Engineer(name: name)",
          "description": "Default query shown by the Felidae: Run Query command."
        },
        "felidae.celidaePath": {
          "type": "string",
          "default": "build/celidae.exe",
          "description": "Path to the Celidae fact relationship visualizer. Relative paths are resolved from the workspace folder."
        },
        "felidae.debugInterpreterPath": {
          "type": "string",
          "default": "build/felidae_debug.exe",
          "description": "Path to the Felidae Lexer-Parser-AST Analyzer debugger. Relative paths are resolved from the workspace folder."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "felidae.runMain",
          "when": "resourceLangId == felidae && felidaeHasMain",
          "group": "navigation"
        },
        {
          "command": "felidae.debugMain",
          "when": "resourceLangId == felidae && felidaeHasMain",
          "group": "navigation"
        },
        {
          "command": "felidae.runQuery",
          "when": "resourceLangId == felidae",
          "group": "navigation"
        },
        {
          "command": "felidae.visualize",
          "when": "resourceLangId == felidae",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "generate:libraries": "node scripts/generate-libraries.js",
    "generate:builtin-docs": "node scripts/generate-builtin-docs.js",
    "precompile": "npm run generate:libraries && npm run generate:builtin-docs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "node --check out/extension.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cytoscape": "^3.34.0"
  }
}

