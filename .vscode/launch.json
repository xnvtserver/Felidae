{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Felidae Query (.fx)",
      "type": "felidae",
      "request": "launch",
      "program": "${file}",
      "stopOnEntry": true
    },
    {
      "name": "Windows: Debug Felidae Interpreter (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae.exe",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Linux: Debug Felidae Interpreter (GCC or Clang)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae",
      "args": ["${workspaceFolder}/v2_examples/air_conditioner_theorem_solver.fx"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "macOS: Debug Felidae Interpreter (Clang)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae",
      "args": ["${workspaceFolder}/v2_examples/air_conditioner_theorem_solver.fx"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
