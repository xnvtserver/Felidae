{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows: Debug Felidae interpreter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/Debug/felidae.exe",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build Felidae (Debug)"
    },
    {
      "name": "Linux: Debug Felidae interpreter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Felidae (Debug)"
    },
    {
      "name": "macOS: Debug Felidae interpreter",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Felidae (Debug)"
    }
  ]
}
