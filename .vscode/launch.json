{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows: Debug Felidae Compiler (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_compiler.exe",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\libtorch\\lib;${env:PATH}"
        }
      ]
    },
    {
      "name": "Windows: Debug Form VM (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_vm.exe",
      "args": [
        "${workspaceFolder}/build/debug/${fileBasenameNoExtension}.bin"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\libtorch\\lib;${env:PATH}"
        }
      ]
    },
    {
      "name": "Linux: Debug Felidae Compiler (GCC or Clang)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_compiler",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Linux: Debug Form VM (GCC or Clang)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_vm",
      "args": [
        "${workspaceFolder}/build/debug/${fileBasenameNoExtension}.bin"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "macOS: Debug Felidae Compiler (Clang)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_compiler",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "macOS: Debug Form VM (Clang)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/felidae_vm",
      "args": [
        "${workspaceFolder}/build/debug/${fileBasenameNoExtension}.bin"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
