{
  "name": "tree-sitter-felidae",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Felidae functional logic language.",
  "license": "MIT",
  "main": "grammar.js",
  "keywords": [
    "tree-sitter",
    "felidae",
    "logic-language"
  ],
  "tree-sitter": [
    {
      "scope": "source.felidae",
      "file-types": [
        "fx"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.6"
  }
}
